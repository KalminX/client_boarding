# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-client-onboarding-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default is SQLite)
# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/client_boarding

# Worker Settings
WORKER_POLL_INTERVAL=2.0
WORKER_BATCH_SIZE=10
WORKER_LEASE_DURATION_SECONDS=60
WORKER_MAX_RETRIES=3
WORKER_BASE_BACKOFF_SECONDS=5

# Integrations Configuration (mock vs real)
EMAIL_ADAPTER=mock          # choices: mock, console, smtp
STORAGE_ADAPTER=mock        # choices: mock, google_drive, local
CRM_ADAPTER=mock            # choices: mock, hubspot, salesforce
TASK_ADAPTER=mock           # choices: mock, asana, clickup
AI_EXTRACTOR_ADAPTER=mock   # choices: mock, claude

# Anthropic Claude API (optional, used when AI_EXTRACTOR_ADAPTER=claude)
ANTHROPIC_API_KEY=

# Webhook Authentication Secret
WEBHOOK_SHARED_SECRET=super-secret-webhook-signing-key-12345
